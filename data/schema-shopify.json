    {
      "@type": "FAQPage",
      "@id": "https://www.trinitydeck.com/services/custom-shopify-development/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can you work with our existing theme, or do you rebuild?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We work inside your existing theme wherever it's sound. Replacing a working theme is usually the expensive answer to a cheap problem, and a clean theme is often what your page speed depends on. We'll tell you honestly if a rebuild is genuinely the right call."
          }
        },
        {
          "@type": "Question",
          "name": "How much does a Shopify store build cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Builds start from around £1,500 for a focused store and rise with page count, product count and integrations. The number moves on scope, not on hours. We quote a fixed price and a fixed date before any work starts, and we don't change either without your written approval."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a Shopify build take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most builds ship in seven to fifteen working days from the day we have all your content and access. The clock starts then, not at signature. How fast approvals come back is the single biggest factor in which end of that range you land on."
          }
        },
        {
          "@type": "Question",
          "name": "Who owns the website and accounts you build?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You do, entirely. Every account is created in your name, nothing is locked to our email, and handover includes full documentation and a recorded walkthrough. You could take all of it elsewhere tomorrow without asking us for anything."
          }
        },
        {
          "@type": "Question",
          "name": "How do I cancel if it isn't working?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Any monthly service can be cancelled on 30 days' notice, for any reason, without penalty. We'll ask why, but you don't have to tell us. One-time work is paid half up front and half on completion, so you're never more than half exposed on work not yet delivered."
          }
        }
      ]
    }
